    "iso-639-1": "^2.1.13",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "jsonfile": "^6.1.0",
    "katex": "^0.15.3",
    "keytar": "^7.9.0",
    "mermaid": "^10.0.0",
    "minizlib": "^2.1.2",
    "mitt": "^3.0.1",
    "native-keymap": "^3.3.0",
    "pinia": "^3.0.4",
    "plist": "^3.0.5",
    "popper.js": "^1.16.1",
    "prismjs": "^1.27.0",
    "safer-buffer": "^2.1.2",
    "snabbdom": "^3.6.3",
    "snabbdom-to-html": "^7.1.0",
    "source-map-support": "^0.5.21",
    "turndown": "^7.1.1",
    "underscore": "^1.13.2",
    "universalify": "^2.0.1",
    "unsplash-js": "^7.0.15",
    "vega": "^5.22.1",
    "vega-embed": "^6.20.8",
    "vega-lite": "^5.2.0",
    "vscode-ripgrep": "^1.12.1",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0",
    "webfontloader": "^1.6.28"
