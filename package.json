    "execall": "^2.0.0",
    "fast-deep-equal": "^3.1.3",
    "flowchart.js": "^1.17.1",
    "fontmanager-redux": "^1.1.0",
    "fs-extra": "^10.0.1",
    "fuzzaldrin": "^2.1.0",
