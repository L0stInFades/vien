{
  "name": "vien",
  "version": "0.17.5",
  "homepage": "https://github.com/L0stInFades/vien",
  "description": "Calm Markdown for long-form writing",
  "license": "MIT",
  "main": "./dist/electron/main.js",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run unit && pnpm run test:specs && pnpm run electron:build",
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:dir": "electron-vite build && electron-builder --dir",
    "generate:icons": "node tools/generateAppIcons.js",
    "release:linux": "electron-vite build && electron-builder build --linux",
    "release:mac": "electron-vite build && electron-builder build --mac",
    "release:win": "electron-vite build && electron-builder build --win",
    "debug:ui-shots": "pnpm run electron:build && node tools/captureUiDebugShots.js",
    "verify:mac-bundle": "node tools/verifyPackagedMacApp.js",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "e2e": "pnpm run electron:build && cross-env MARKTEXT_EXIT_ON_ERROR=1 playwright test -c test/e2e/playwright.config.js test/e2e",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "postinstall": "node .electron-vue/postinstall.js && pnpm run rebuild",
    "test": "pnpm run unit && pnpm run e2e",
    "test:specs": "node -r ./test/specs/register-ts.js test/specs/commonMark/run.spec.js && node -r ./test/specs/register-ts.js test/specs/gfm/run.spec.js",
    "unit": "vitest run",
    "unit:watch": "vitest",
    "build:muya": "cd src/muya && webpack --progress --config webpack.config.js",
    "release:muya": "pnpm run build:muya && cd src/muya && pnpm publish",
    "rebuild": "electron-rebuild -f",
    "gen-third-party": "node tools/generateThirdPartyLicense.js",
    "validate-licenses": "node tools/validateLicenses.js",
    "deobfuscateStackTrace": "node tools/deobfuscateStackTrace.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@hfelix/electron-localshortcut": "^4.0.1",
    "@marktext/file-icons": "^1.0.6",
    "@octokit/rest": "^18.12.0",
    "arg": "^5.0.1",
    "axios": "^0.26.1",
    "ced": "^2.0.0",
